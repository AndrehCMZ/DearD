--- !u!114 &1900077064
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1900077062}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"\xBFQu\xE9 est\xE1 pasando? \xBFPor qu\xE9 me juzgan por algo que no fue mi culpa? Solo me miran con esos ojos retorcidos que me brindan un peso emocional que no manejo. Ni siquiera ten\xEDa nada que ver en ese momento, solo les dije: \xABAlej\xE9monos\xBB, pero solo fueron o\xEDdos sordos hacia mis plegarias de salvar a un alma ya condenada. Y pas\xF3, muri\xF3, y ahora cargo con estos problemas que no son completamente m\xEDos. Pero aun as\xED hay algo que pesa en mi mente, y es que acept\xE9 ir a ese lugar abandonado solo para o\xEDr sus risas... Jajajaja, no s\xE9 qu\xE9 me pasa... Jajajaja, todo esto es una mierda. No es mi culpa... \xA1NO ES MI CULPA! \xA1MALDITA SEA, NO ES MI CULPA! \xA1PEDAZOS DE MIERDA, NADA DE ESTO TIENE QUE VER CONMIGO! LOS ODIO. JAJAJAJA, JAJAJAJA, JAJAJAJA, JAJAJAJA... Pero aun as\xED... yo fui el que empez\xF3 esto.\"\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
